# Salin menjadi server/.env lalu isi. File .env TIDAK ikut di-upload ke GitHub (ada di .gitignore).
# Di Railway/Render, isi nilai yang sama lewat Dashboard -> Variables (bukan lewat file).
LIVEKIT_URL=wss://NAMAPROYEK.livekit.cloud
LIVEKIT_API_KEY=ISI_API_KEY
LIVEKIT_API_SECRET=ISI_API_SECRET
# Folder penyimpan data kelas (di Railway: pasang Volume ke /app/data)
DATA_DIR=./data
PORT=3000
